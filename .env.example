# JanSetu environment variable reference
# Placeholder values only. Never commit real credentials.

# Go backend
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
JANSETU_AI_URL=http://localhost:8000
PORT=8080

# Optional Supabase report-photo storage
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
# SUPABASE_SECRET_KEY=REPLACE_ME

# Python AI service
JANSETU_AI_PROVIDER=gemini
JANSETU_AI_MODEL=REPLACE_WITH_GEMINI_MODEL
JANSETU_AI_API_KEY=REPLACE_ME
JANSETU_EMBEDDING_API_KEY=REPLACE_ME

# Hosted AI environment
# APP_ENV=production

# Optional AI retry tuning
# JANSETU_AI_TIMEOUT_SECONDS=20
# JANSETU_AI_MAX_ATTEMPTS=2
# JANSETU_AI_BASE_DELAY_SECONDS=0.25
# JANSETU_AI_BACKOFF_MULTIPLIER=2
# JANSETU_AI_MAX_DELAY_SECONDS=4
# JANSETU_AI_JITTER_RATIO=0.2
